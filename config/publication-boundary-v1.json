    "schemas/**",
    "src/**",
    "scripts/**",
    "tests/**",
    "test/**",
    "examples/acquisition-fixtures/**",
    "examples/acquisition-pilot/**",
    "examples/aie-fixtures/**",
    "examples/cognitive-substitution-v0.1.mjs",
    "examples/cognitive-substitution-v0.2.mjs"
  ],
  "deny": [
    ".git/**",
    ".arca/**",
    ".arca-demo/**",
    ".arca-status/**",
    ".arca-publication-preview/**",
    ".d2-runtime/**",
    "node_modules/**",
    "coverage/**",
    "dist/**",
    "build/**",
    "output/**",
    "tmp/**",
    "release/**",
    "remote-jobs/**",
    "remote-mesh/**",
    "project-history/**",
    "federation/**",
    ".github/workflows/arca-machine-bridge*.yml",
    ".github/workflows/federation-*.yml",
    ".github/workflows/arca-status-email.yml",
    ".github/workflows/mega-brain-*.yml",
    ".github/workflows/arca-live-*.yml",
    ".github/workflows/arca-node-introduction-validation.yml",
    ".github/workflows/arca-federation-response-validation.yml",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa",
    "**/id_ed25519",
    "**/credentials.json",
    "**/secrets.json"
  ],
