{
  "format": "arca-publication-boundary-v1",
  "version": "1.0.0",
  "defaultAction": "exclude",
  "historyMode": "fresh-root-only",
  "creatorApprovalRequired": true,
  "publicRepositoryCreationAllowed": false,
  "manifestName": "PUBLICATION_MANIFEST.json",
  "allow": [
    ".gitattributes",
    ".gitignore",
    ".npmignore",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "package.json",
    "package-lock.json",
    "config/publication-boundary-v1.json",
