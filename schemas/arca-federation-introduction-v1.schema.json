{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arca:schema:arca-federation-introduction-v1",
  "title": "ARCA Federation Introduction V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "introductionId",
    "issuedAt",
    "expiresAt",
    "sender",
    "about",
    "manifest",
    "discovery",
    "proposal",
    "responseOptions"
  ],
  "properties": {
    "format": {
      "const": "arca-federation-introduction-v1"
    },
    "version": {
      "const": 1
    },
    "introductionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "sender": {
      "type": "object"
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "trustSummary"
      ],
      "properties": {
        "name": {
          "const": "ARCA"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "trustSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "manifest": {
      "type": "object"
    },
    "discovery": {
      "type": "object"
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requestedScopes",
        "taskIncluded",
        "executionRequested",
        "trustGrantRequested",
        "admissionRequested",
        "authMaterialRequested"
      ],
      "properties": {
        "kind": {
          "const": "federation-enrollment-evaluation"
        },
        "requestedScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "taskIncluded": {
          "const": false
        },
        "executionRequested": {
          "const": false
        },
        "trustGrantRequested": {
          "const": false
        },
        "admissionRequested": {
          "const": false
        },
        "authMaterialRequested": {
          "const": false
        }
      }
    },
    "responseOptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "accept-evaluation",
          "decline",
          "request-info",
          "offer-endpoint",
          "offer-auth-method",
          "limit-scope"
        ]
      }
    }
  }
}
