{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arca:schema:arca-work-result-v1",
  "title": "ARCA Work Result V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["format","jobId","requestId","workerId","signatureVerified","payloadSha256","keyFingerprint","lifecycle","status","safety"],
  "properties": {
    "format": {"const": "arca-work-result-v1"},
    "jobId": {"type": "string", "minLength": 1},
    "requestId": {"type": "string", "minLength": 1},
    "workerId": {"type": "string", "minLength": 1},
    "signatureVerified": {"const": true},
    "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "keyFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "lifecycle": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["event"],
        "properties": {"event": {"enum": ["queued","claimed","running","completed","failed","rejected"]}}
      }
    },
    "status": {"enum": ["completed","failed","rejected"]},
    "output": {},
    "reason": {"type": "string"},
    "selectionReason": {"type": "string"},
    "safety": {
      "type": "object",
      "required": ["mainMutated","merged"],
      "properties": {
        "mainMutated": {"const": false},
        "merged": {"const": false},
        "shellExecuted": {"const": false},
        "arbitraryShellExecuted": {"const": false}
      },
      "anyOf": [
        {"required": ["shellExecuted"]},
        {"required": ["arbitraryShellExecuted"]}
      ]
    }
  }
}
