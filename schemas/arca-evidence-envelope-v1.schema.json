{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.invalid/schemas/arca-evidence-envelope-v1.schema.json",
  "title": "ARCA Evidence Envelope V1",
  "type": "object",
  "required": ["schema", "sourceId", "sourceClass", "recordKey", "jurisdiction", "sourceUrl", "acquiredAt", "retrievalMode", "rawSha256", "normalizedSha256", "transformations", "custodyRef", "coverage", "humanReviewRequired", "adverseFinding", "envelopeSha256"],
  "properties": {
    "schema": {"const": "arca.evidence-envelope.v1"},
    "sourceId": {"type": "string", "minLength": 1},
    "sourceClass": {"type": "string", "minLength": 1},
    "recordKey": {"type": "string", "minLength": 1},
    "jurisdiction": {"type": "string", "pattern": "^BR/UF/[A-Z]{2}$"},
    "municipalityCode": {"type": ["string", "null"]},
    "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
    "acquiredAt": {"type": "string", "format": "date-time"},
    "retrievalMode": {"const": "OFFLINE_FIXTURE"},
    "rawSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalizedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transformations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "custodyRef": {"type": "string", "minLength": 1},
    "coverage": {"type": "object"},
    "humanReviewRequired": {"const": true},
    "adverseFinding": {"const": false},
    "envelopeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
