{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.invalid/schemas/arca-external-enrichment-v1.schema.json",
  "title": "ARCA External Enrichment V1",
  "description": "Contrato fail-closed para solicitar enriquecimento externo opcional sem promover automaticamente resultados de terceiros a evidência oficial.",
  "type": "object",
  "required": [
    "schema",
    "provider",
    "entity",
    "requestedFields",
    "purpose",
    "costPolicy",
    "dataPolicy",
    "humanReviewRequired",
    "executionState"
  ],
  "properties": {
    "schema": {
      "const": "arca.external-enrichment.v1"
    },
    "provider": {
      "type": "object",
      "required": ["id", "enabled", "paidExecutionAllowed"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "enabled": {
          "type": "boolean"
        },
        "paidExecutionAllowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["kind", "identifiers"],
      "properties": {
        "kind": {
          "enum": ["PERSON", "COMPANY", "ORGANIZATION"]
        },
        "identifiers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "requestedFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "costPolicy": {
      "type": "object",
      "required": [
        "monetaryCostPossible",
        "humanCostApprovalRequired",
        "maxEntities",
        "automaticPaidRetriesAllowed"
      ],
      "properties": {
        "monetaryCostPossible": {
          "type": "boolean"
        },
        "humanCostApprovalRequired": {
          "const": true
        },
        "approved": {
          "type": "boolean",
          "default": false
        },
        "currency": {
          "type": ["string", "null"]
        },
        "maxMonetaryCost": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "maxEntities": {
          "type": "integer",
          "minimum": 1
        },
        "automaticPaidRetriesAllowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "dataPolicy": {
      "type": "object",
      "required": [
        "minimizeFields",
        "personalContactDataAllowed",
        "reverseContactLookupAllowed",
        "darkWebMonitoringAllowed",
        "rawResponsePublic"
      ],
      "properties": {
        "minimizeFields": {
          "const": true
        },
        "personalContactDataAllowed": {
          "const": false
        },
        "reverseContactLookupAllowed": {
          "const": false
        },
        "darkWebMonitoringAllowed": {
          "const": false
        },
        "rawResponsePublic": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "humanReviewRequired": {
      "const": true
    },
    "executionState": {
      "enum": [
        "DESIGN_ONLY",
        "OFFLINE_FIXTURE",
        "READY_FOR_COST_APPROVAL",
        "AUTHORIZED",
        "EXECUTED",
        "BLOCKED"
      ]
    },
    "initialEpistemicState": {
      "const": "THIRD_PARTY_LEAD"
    }
  },
  "additionalProperties": false
}
