{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.invalid/schemas/arca-aie-detector-v1.schema.json",
  "title": "ARCA AIE Detector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "detectorId", "version", "domain", "description", "parameters", "legitimateExplanations", "humanReviewRequired"],
  "properties": {
    "format": { "const": "arca-aie-detector-v1" },
    "detectorId": { "type": "string", "minLength": 3 },
    "version": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "parameters": { "type": "object" },
    "legitimateExplanations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "humanReviewRequired": { "const": true }
  }
}
