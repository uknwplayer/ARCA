{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.invalid/schemas/arca-aie-procurement-record-v1.schema.json",
  "title": "ARCA AIE Procurement Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "procurementId", "processId", "supplierId", "supplierCnpj", "supplierName", "amount", "participantCount", "additivePercent", "modality", "objectDescription", "publishedAt", "sourceRefs", "normalization"],
  "properties": {
    "format": { "const": "arca-aie-procurement-record-v1" },
    "procurementId": { "type": "string", "minLength": 1 },
    "processId": { "type": ["string", "null"] },
    "supplierId": { "type": ["string", "null"] },
    "supplierCnpj": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{12}[0-9]{2}$" },
    "supplierName": { "type": ["string", "null"] },
    "amount": { "type": ["number", "null"], "minimum": 0 },
    "participantCount": { "type": ["integer", "null"], "minimum": 0 },
    "additivePercent": { "type": "number", "minimum": 0 },
    "modality": { "type": "string", "minLength": 1 },
    "objectDescription": { "type": ["string", "null"] },
    "publishedAt": { "type": ["string", "null"] },
    "sourceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "warnings", "originalShapeHash"],
      "properties": {
        "method": { "const": "public-procurement-normalizer-v1" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "originalShapeHash": { "type": "string", "pattern": "^RAW-[A-F0-9]{12}$" }
      }
    }
  }
}
