{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.local/schema/arca-role-conformance-profile-v1.schema.json",
  "title": "ARCA Role Conformance Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format","version","profileId","profileVersion","roleId","roleContractHash",
    "syntheticOnly","sideEffects","subjectNetworkRequired","timeoutMs","maxEvidenceAgeMs",
    "inputSchema","outputSchema","fixtures","profileHash"
  ],
  "properties": {
    "format": {"const": "arca-role-conformance-profile-v1"},
    "version": {"const": 1},
    "profileId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"},
    "profileVersion": {"type": "string", "minLength": 1, "maxLength": 40},
    "roleId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"},
    "roleContractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "syntheticOnly": {"const": true},
    "sideEffects": {"const": false},
    "subjectNetworkRequired": {"const": false},
    "timeoutMs": {"type": "integer", "minimum": 1000, "maximum": 30000},
    "maxEvidenceAgeMs": {"type": "integer", "minimum": 60000, "maximum": 2592000000},
    "inputSchema": {"type": "object"},
    "outputSchema": {"type": "object"},
    "fixtures": {"type": "array", "minItems": 1, "maxItems": 20},
    "profileHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
