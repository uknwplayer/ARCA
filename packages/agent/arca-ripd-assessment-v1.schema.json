{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://arca.local/schema/arca-ripd-assessment-v1.schema.json",
  "title":"ARCA RIPD Assessment v1",
  "type":"object",
  "additionalProperties":false,
  "required":["format","assessmentId","processingId","purpose","dataCategories","processingOperations","subjectGroups","legalBasisRefs","safeguards","identifiedRisks","indicators","highRiskSignals","legitimateInterestBasis","recommendation","gaps","necessityAssessment","proportionalityAssessment","residualRiskAssessment","formalRipdGenerated","anpdSubmissionPerformed","humanReviewRequired","legalAdviceProvided","automatedLegalConclusion","assessedAt","assessmentHash"],
  "properties":{
    "format":{"const":"arca-ripd-assessment-v1"},
    "assessmentId":{"type":"string"},
    "processingId":{"type":"string"},
    "purpose":{"type":"string","minLength":1,"maxLength":1500},
    "dataCategories":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "processingOperations":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "subjectGroups":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "legalBasisRefs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "safeguards":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "identifiedRisks":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "indicators":{"type":"object"},
    "highRiskSignals":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "legitimateInterestBasis":{"type":"boolean"},
    "recommendation":{"enum":["routine-review","consider-ripd","prepare-ripd"]},
    "gaps":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "necessityAssessment":{"type":"string","maxLength":3000},
    "proportionalityAssessment":{"type":"string","maxLength":3000},
    "residualRiskAssessment":{"type":"string","maxLength":3000},
    "formalRipdGenerated":{"const":false},
    "anpdSubmissionPerformed":{"const":false},
    "humanReviewRequired":{"type":"boolean"},
    "legalAdviceProvided":{"const":false},
    "automatedLegalConclusion":{"const":false},
    "assessedAt":{"type":"string","format":"date-time"},
    "assessmentHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
