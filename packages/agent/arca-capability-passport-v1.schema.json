{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.local/schema/arca-capability-passport-v1.schema.json",
  "title": "ARCA Capability Passport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "participantId", "kind", "provider", "source", "descriptorHash", "capabilities", "updatedAt"],
  "properties": {
    "format": {"const": "arca-capability-passport-v1"},
    "participantId": {"type": "string", "minLength": 1, "maxLength": 120},
    "kind": {"enum": ["agent", "worker", "tool", "connector", "model", "service"]},
    "provider": {"type": "string", "minLength": 1, "maxLength": 120},
    "model": {"type": ["string", "null"], "maxLength": 160},
    "labels": {"type": "object"},
    "source": {"type": "string", "minLength": 1, "maxLength": 80},
    "descriptorHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "input", "output", "networkRequired", "humanReviewRequired", "riskClass", "fingerprint", "verifiedAt"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 120},
          "version": {"type": "string", "minLength": 1, "maxLength": 40},
          "status": {"enum": ["declared", "verified", "degraded", "unavailable", "unknown", "verification-needed"]},
          "input": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "output": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "networkRequired": {"type": ["boolean", "null"]},
          "humanReviewRequired": {"type": ["boolean", "null"]},
          "riskClass": {"enum": ["low", "medium", "high", "critical", "unspecified"]},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "verifiedAt": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
