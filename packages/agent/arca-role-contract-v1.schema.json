{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arca.local/schema/arca-role-contract-v1.schema.json",
  "title": "ARCA Role Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "roleId",
    "version",
    "description",
    "requiredCapabilities",
    "allowedKinds",
    "riskClass",
    "verifiedOnly",
    "conformanceRequired",
    "authorizationRequired",
    "substitutionPolicy",
    "humanReviewRequired",
    "behaviorEnvelope",
    "contractHash"
  ],
  "properties": {
    "format": {
      "const": "arca-role-contract-v1"
    },
    "roleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,120}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,120}$"
      }
    },
    "allowedKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "agent",
          "worker",
          "tool",
          "connector",
          "model",
          "service"
        ]
      }
    },
    "riskClass": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unspecified"
      ]
    },
    "verifiedOnly": {
      "const": true
    },
    "authorizationRequired": {
      "const": true
    },
    "substitutionPolicy": {
      "const": "preflight-only"
    },
    "humanReviewRequired": {
      "type": "boolean"
    },
    "behaviorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxOutputBytes",
        "requiredTopLevelKeys",
        "requireRequestCorrelation"
      ],
      "properties": {
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2097152
        },
        "requiredTopLevelKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,120}$"
          }
        },
        "requireRequestCorrelation": {
          "type": "boolean"
        }
      }
    },
    "contractHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conformanceRequired": {
      "const": true
    }
  }
}
